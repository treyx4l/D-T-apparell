# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
APP_ENV=development
APP_NAME="D&T Apparels"
BASE_URL=
SESSION_SECRET=change-this-to-a-random-32-byte-string
ADMIN_PATH=dt-admin

# OAuth redirect (must match Supabase Auth → URL Configuration → Redirect URLs)
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback.php

# WhatsApp order notification (Ghana format: 233XXXXXXXXX)
WHATSAPP_NUMBER=233544570238

# Supabase Storage bucket for product images (must match bucket created in Supabase)
STORAGE_BUCKET=product-images

{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "auth/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "dt-admin/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "rewrites": [
    {
      "source": "/store",
      "destination": "/store.php"
    },
    {
      "source": "/dt-admin",
      "destination": "/dt-admin/index.php"
    },
    {
      "source": "/dt-admin/",
      "destination": "/dt-admin/index.php"
    },
    {
      "source": "/",
      "destination": "/index.php"
    }
  ]
}

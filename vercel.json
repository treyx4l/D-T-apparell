{
  "version": 2,
  "builds": [
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "auth/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "dt-admin/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "api/*.php",
      "use": "vercel-php@0.7.3"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/dt-admin/(.*)",
      "dest": "/dt-admin/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/auth/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/store",
      "dest": "/store.php"
    },
    {
      "src": "/store.php",
      "dest": "/store.php"
    },
    {
      "src": "/index.php",
      "dest": "/index.php"
    },
    {
      "src": "/",
      "dest": "/index.php"
    }
  ]
}
